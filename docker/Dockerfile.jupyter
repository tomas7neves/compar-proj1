# Jupyter para explorar dados e testar código (como o contentor jupyter do Lab 03).
# Mesma imagem do cluster: a versão do Spark e do Python do driver tem de ser igual à dos workers.
FROM spark:4.2.0-python3
USER root
ENV HOME=/tmp PYTHONPATH=/opt/spark/python
RUN pip install --no-cache-dir jupyterlab py4j pandas pyarrow matplotlib \
    && mkdir -p /tmp/jupyter/runtime /tmp/jupyter/data && chmod -R 777 /tmp/jupyter
WORKDIR /project
